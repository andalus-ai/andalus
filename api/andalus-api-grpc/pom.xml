<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.andalus</groupId>
        <artifactId>andalus-parent</artifactId>
        <version>0.0.1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>andalus-api-grpc</artifactId>
    <name>Andalus API gRPC</name>
    <description>gRPC API for Andalus Platform</description>

    <dependencies>
        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-aqli-sdk</artifactId>
            <version>${andalus-aqli-sdk.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>tech.kayys.alkhawarizm</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>tech.kayys.aqli</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-orchestration</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-project</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-hitl</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-spi</artifactId>
            <version>${project.version}</version>
        </dependency>


        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-knowledge-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-memory</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.kayys.andalus</groupId>
            <artifactId>andalus-memory-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-grpc</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
