{"product":"Andalus","status":{"product":"Andalus","version":"1.0.0-SNAPSHOT","components":[{"name":"Aqli","role":"Inference, serving, and training engine","state":"external","endpoint":"configured by backend adapter","healthPercent":80},{"name":"Gamelan","role":"Workflow execution engine","state":"external","endpoint":"configured by workflow backend","healthPercent":80},{"name":"Agent Core","role":"Agentic orchestration and skills","state":"local","endpoint":"agent-spi + agent-core","healthPercent":90},{"name":"RAG Runtime","role":"Retrieval, plugins, and response assembly","state":"local","endpoint":"rag-runtime","healthPercent":90},{"name":"MCP","role":"Dynamic tool bridge","state":"adapter-ready","endpoint":"agent-mcp + andalus-tool-mcp","healthPercent":70}],"activeSkills":12,"notes":["Andalus SDK is the shared source of truth for agent product surfaces.","Andalus CLI is product-owned and separate from Aqli CLI.","Tamboui is used as a renderer reference, not the platform contract.","The CLI target is an agent workbench for coding, assistant, and workflow products.","Next SDK adapters should wire local runtime, remote API, and packaged agents."]},"catalog":{"product":"Andalus","coreEngine":"agents, skills, tools, MCP, RAG, memory, workflows, and harness checks","surfaces":[{"id":"coding-agent","name":"Coding Agent","role":"Workspace-aware terminal agent in the style of Gemini CLI or Claude Code.","engineCapabilities":["planning","tool-use","repo-context","patching","harness-checks"],"adapterBoundaries":["tools-spi","agent-orchestration","agent-shaker"],"policy":{"surfaceId":"coding-agent","memoryPreferred":true,"workspacePreferred":true,"harnessPreferred":true,"workflowPreferred":false,"suggestedSkills":["repo","tools","patching"],"requiredContextKeys":["surfaceId","workspace"],"routingHints":["inspect-workspace","plan-harness","prefer-tool-use"]},"profiles":[]},{"id":"assistant-agent","name":"Assistant Agent","role":"Task and conversation agent with memory, RAG, MCP, and skill routing.","engineCapabilities":["chat","memory","rag","skills","mcp"],"adapterBoundaries":["agent-spi","rag-runtime","memory-runtime","agent-mcp"],"policy":{"surfaceId":"assistant-agent","memoryPreferred":true,"workspacePreferred":false,"harnessPreferred":false,"workflowPreferred":false,"suggestedSkills":["memory","rag","mcp"],"requiredContextKeys":["surfaceId"],"routingHints":["prefer-memory","prefer-rag","allow-mcp-skills"]},"profiles":[]},{"id":"workflow-platform","name":"Low-Code Agentic Workflow","role":"Workflow product surface for Gamelan or n8n-style agent nodes and automations.","engineCapabilities":["workflow-runs","signals","human-in-loop","agent-nodes","observability"],"adapterBoundaries":["workflow-backend","agent-backend-gamelan","hitl","runtime-quarkus"],"policy":{"surfaceId":"workflow-platform","memoryPreferred":true,"workspacePreferred":false,"harnessPreferred":false,"workflowPreferred":true,"suggestedSkills":["workflow","hitl","observability"],"requiredContextKeys":["surfaceId","workflowId"],"routingHints":["prefer-gamelan-workflow","preserve-human-in-loop","emit-run-metadata"]},"profiles":[]},{"id":"platform-admin","name":"Platform Admin","role":"Operator surface for tenants, skills, tools, plugins, RAG, SLOs, and runtime health.","engineCapabilities":["tenancy","skills","plugins","rag-admin","slo-admin"],"adapterBoundaries":["agent-api","skill-management","rag-config","andalus-rag-slo"],"policy":{"surfaceId":"platform-admin","memoryPreferred":false,"workspacePreferred":false,"harnessPreferred":false,"workflowPreferred":false,"suggestedSkills":["skills","rag-admin","slo-admin"],"requiredContextKeys":["surfaceId","tenantId"],"routingHints":["prefer-admin-audit","require-tenant-scope","avoid-implicit-tool-execution"]},"profiles":[]}],"profiles":[]},"commandQuery":{"surfaceId":null,"profileId":null,"resolvedSurfaceId":null,"category":null,"commandId":null,"contractJsonSchemaId":"urn:andalus:contract:andalus.run.lifecycle:v1:run-result","filtered":true},"commandPalette":["run <task> --json"],"commands":[{"id":"run-result-json","title":"Run Result JSON","command":"run <task> --json","category":"Runs","description":"Submit a run and render the immediate run result envelope.","surfaceIds":[],"localOnly":false,"contracts":[{"schema":"andalus.run.lifecycle","version":1,"envelope":"run-result","jsonSchemaId":"urn:andalus:contract:andalus.run.lifecycle:v1:run-result"}]}],"nextActions":["Attach SDK run execution to the local Andalus agent runtime.","Use workspace context inspection to seed coding-agent products.","Expose MCP, RAG, memory, and workflow adapters through stable SDK and CLI commands.","Keep Tamboui as a renderer adapter behind the SDK workbench model."]}
